#pragma code_page(65001)

#include <windows.h>
#include "resources.h"

1 RT_MANIFEST "picolet.manifest"
IDI_PICOLET ICON "picolet.ico"

IDD_HOTKEYS DIALOGEX 0, 0, 266, 272
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Picolet 快捷键设置"
FONT 9, "Microsoft YaHei UI"
BEGIN
    GROUPBOX "全局", -1, 10, 8, 246, 37
    LTEXT "开始截图", -1, 22, 25, 58, 12
    PUSHBUTTON "", IDC_SHORTCUT_FIRST, 85, 22, 105, 15
    PUSHBUTTON "清除", IDC_CLEAR_FIRST, 201, 22, 43, 15

    GROUPBOX "截图内", -1, 10, 53, 246, 160
    LTEXT "全屏", -1, 22, 71, 58, 12
    PUSHBUTTON "", IDC_SHORTCUT_FIRST + 1, 85, 68, 105, 15
    PUSHBUTTON "清除", IDC_CLEAR_FIRST + 1, 201, 68, 43, 15
    LTEXT "复制", -1, 22, 91, 58, 12
    PUSHBUTTON "", IDC_SHORTCUT_FIRST + 2, 85, 88, 105, 15
    PUSHBUTTON "清除", IDC_CLEAR_FIRST + 2, 201, 88, 43, 15
    LTEXT "另存为 PNG", -1, 22, 111, 58, 12
    PUSHBUTTON "", IDC_SHORTCUT_FIRST + 3, 85, 108, 105, 15
    PUSHBUTTON "清除", IDC_CLEAR_FIRST + 3, 201, 108, 43, 15
    LTEXT "贴图", -1, 22, 131, 58, 12
    PUSHBUTTON "", IDC_SHORTCUT_FIRST + 4, 85, 128, 105, 15
    PUSHBUTTON "清除", IDC_CLEAR_FIRST + 4, 201, 128, 43, 15
    LTEXT "撤销", -1, 22, 151, 58, 12
    PUSHBUTTON "", IDC_SHORTCUT_FIRST + 5, 85, 148, 105, 15
    PUSHBUTTON "清除", IDC_CLEAR_FIRST + 5, 201, 148, 43, 15
    LTEXT "重做", -1, 22, 171, 58, 12
    PUSHBUTTON "", IDC_SHORTCUT_FIRST + 7, 85, 168, 105, 15
    PUSHBUTTON "清除", IDC_CLEAR_FIRST + 7, 201, 168, 43, 15
    LTEXT "取消", -1, 22, 191, 58, 12
    PUSHBUTTON "", IDC_SHORTCUT_FIRST + 6, 85, 188, 105, 15
    PUSHBUTTON "清除", IDC_CLEAR_FIRST + 6, 201, 188, 43, 15

    LTEXT "点击按键开始录制。清除后该操作仍可用鼠标执行。", IDC_SHORTCUT_STATUS, 12, 221, 242, 22, SS_NOPREFIX
    PUSHBUTTON "恢复默认", IDC_SHORTCUT_RESTORE, 12, 246, 60, 16
    DEFPUSHBUTTON "保存", IDOK, 140, 246, 52, 16
    PUSHBUTTON "取消", IDCANCEL, 202, 246, 52, 16
END
