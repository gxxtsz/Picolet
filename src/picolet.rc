#pragma code_page(65001)

#include <windows.h>
#include "resources.h"

1 RT_MANIFEST "picolet.manifest"
IDI_PICOLET ICON "picolet.ico"

IDD_HOTKEYS DIALOGEX 0, 0, 284, 123
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Picolet 快捷键设置"
FONT 9, "Microsoft YaHei UI"
BEGIN
    LTEXT "选区截图", -1, 12, 15, 54, 12
    COMBOBOX IDC_AREA_MODIFIERS, 70, 12, 105, 86, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "+", -1, 181, 15, 12, 12
    COMBOBOX IDC_AREA_KEY, 196, 12, 76, 106, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    LTEXT "全屏截图", -1, 12, 39, 54, 12
    COMBOBOX IDC_DESKTOP_MODIFIERS, 70, 36, 105, 86, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "+", -1, 181, 39, 12, 12
    COMBOBOX IDC_DESKTOP_KEY, 196, 36, 76, 106, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    LTEXT "保存后立即生效，并在下次启动时沿用。", IDC_HOTKEY_STATUS, 12, 65, 260, 22, SS_NOPREFIX
    DEFPUSHBUTTON "保存", IDOK, 159, 95, 53, 16
    PUSHBUTTON "取消", IDCANCEL, 219, 95, 53, 16
END

IDR_PREVIEW_KEYS ACCELERATORS
BEGIN
    "C", ID_PREVIEW_COPY, VIRTKEY, CONTROL
    VK_ESCAPE, ID_PREVIEW_CLOSE, VIRTKEY
END
