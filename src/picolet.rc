#pragma code_page(65001)

#include <windows.h>
#include "resources.h"

1 RT_MANIFEST "picolet.manifest"
IDI_PICOLET ICON "picolet.ico"

IDD_HOTKEYS DIALOGEX 0, 0, 266, 366
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Picolet 设置"
FONT 9, "Microsoft YaHei UI"
BEGIN
    GROUPBOX "通用", -1, 10, 8, 246, 66
    CONTROL "开机自启动", IDC_STARTUP_ENABLE, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 22, 23, 220, 12
    LTEXT "", IDC_STARTUP_STATUS, 22, 40, 222, 28, SS_NOPREFIX

    GROUPBOX "全局快捷键", -1, 10, 82, 246, 37
    LTEXT "开始截图", -1, 22, 99, 58, 12
    PUSHBUTTON "", IDC_SHORTCUT_FIRST, 85, 96, 105, 15
    PUSHBUTTON "清除", IDC_CLEAR_FIRST, 201, 96, 43, 15

    GROUPBOX "截图内快捷键", -1, 10, 127, 246, 180
    LTEXT "全屏", -1, 22, 145, 58, 12
    PUSHBUTTON "", IDC_SHORTCUT_FIRST + 1, 85, 142, 105, 15
    PUSHBUTTON "清除", IDC_CLEAR_FIRST + 1, 201, 142, 43, 15
    LTEXT "复制", -1, 22, 165, 58, 12
    PUSHBUTTON "", IDC_SHORTCUT_FIRST + 2, 85, 162, 105, 15
    PUSHBUTTON "清除", IDC_CLEAR_FIRST + 2, 201, 162, 43, 15
    LTEXT "另存为 PNG", -1, 22, 185, 58, 12
    PUSHBUTTON "", IDC_SHORTCUT_FIRST + 3, 85, 182, 105, 15
    PUSHBUTTON "清除", IDC_CLEAR_FIRST + 3, 201, 182, 43, 15
    LTEXT "贴图", -1, 22, 205, 58, 12
    PUSHBUTTON "", IDC_SHORTCUT_FIRST + 4, 85, 202, 105, 15
    PUSHBUTTON "清除", IDC_CLEAR_FIRST + 4, 201, 202, 43, 15
    LTEXT "撤销", -1, 22, 225, 58, 12
    PUSHBUTTON "", IDC_SHORTCUT_FIRST + 5, 85, 222, 105, 15
    PUSHBUTTON "清除", IDC_CLEAR_FIRST + 5, 201, 222, 43, 15
    LTEXT "重做", -1, 22, 245, 58, 12
    PUSHBUTTON "", IDC_SHORTCUT_FIRST + 7, 85, 242, 105, 15
    PUSHBUTTON "清除", IDC_CLEAR_FIRST + 7, 201, 242, 43, 15
    LTEXT "取消", -1, 22, 265, 58, 12
    PUSHBUTTON "", IDC_SHORTCUT_FIRST + 6, 85, 262, 105, 15
    PUSHBUTTON "清除", IDC_CLEAR_FIRST + 6, 201, 262, 43, 15
    LTEXT "长截图", -1, 22, 285, 58, 12
    PUSHBUTTON "", IDC_SHORTCUT_FIRST + 8, 85, 282, 105, 15
    PUSHBUTTON "清除", IDC_CLEAR_FIRST + 8, 201, 282, 43, 15

    LTEXT "点击按键开始录制。清除后该操作仍可用鼠标执行。", IDC_SHORTCUT_STATUS, 12, 315, 242, 22, SS_NOPREFIX
    PUSHBUTTON "恢复快捷键默认", IDC_SHORTCUT_RESTORE, 12, 340, 96, 16
    DEFPUSHBUTTON "保存", IDOK, 140, 340, 52, 16
    PUSHBUTTON "取消", IDCANCEL, 202, 340, 52, 16
END
